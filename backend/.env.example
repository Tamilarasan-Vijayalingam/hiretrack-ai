# ========================================================
# HireTrack AI - Backend Production Environment Variables
# ========================================================

# Database Configuration (Provided automatically by Render if using Render PostgreSQL)
# Example: jdbc:postgresql://dpg-xxxx-a.oregon-postgres.render.com/hiretrack_db
DATABASE_URL=jdbc:postgresql://your-database-host:5432/your-database-name
DATABASE_USER=your_db_username
DATABASE_PASSWORD=your_db_password

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets PORT automatically)
PORT=8080

# JWT Authentication Secret
# Provide a secure 256-bit secret key (min 32 characters)
JWT_SECRET=your-secure-random-256-bit-jwt-secret-key-placeholder
JWT_EXPIRATION=86400000

# Production Frontend CORS URL
# Example: https://hiretrack.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# OpenAI API Key (Kept strictly on the backend)
# Example: sk-proj-...
OPENAI_API_KEY=your_openai_api_key_here

# Optional: SMTP Email Server (for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Logging Levels (Recommended: INFO for root, WARN for SQL queries)
LOG_LEVEL=INFO
LOG_LEVEL_SQL=WARN
